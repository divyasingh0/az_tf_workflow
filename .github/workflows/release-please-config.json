{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": false,
  "separate-pull-requests": true,
  "packages": {
    "version": {
      "release-type": "simple",
      "component": "version",
      "include-component-in-tag": true,
      "tag-separator": "-"
    },
    "workflow": {
      "release-type": "simple",
      "component": "workflow",
      "include-component-in-tag": true,
      "tag-separator": "-"
    }
  }
}